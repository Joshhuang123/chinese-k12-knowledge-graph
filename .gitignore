# ── 原始数据不入库 ──
#
# K12-KGraph 原件是 CC BY-NC-SA 4.0，是别人的东西。
# 顺手 commit 进仓库，会把别人的数据库许可证和本项目的许可证搅在一起。
# 跑 ./fetch.sh 拉，拉完自动验 SHA-256。
data/raw/

# ── 归一化结果不入库 ──
# 构建产物，由原件 + 脚本可复现 —— **除了下面两个白名单**：
# selfbuilt-edges.json 的输入 data/lmm-out/ 是一次性模型产出（不再生），
# confirmed-wrong.json 是逐条人工裁决的账本；丢了它们构建就永久降级
# （build_viz 现在会警告，ISSUE-45）。
# 注意目录必须用 /* 写法白名单才生效：整目录忽略（dir/）时 git 根本
# 不进去，! 规则永远轮不到。
data/normalized/*
!data/normalized/selfbuilt-edges.json
!data/normalized/confirmed-wrong.json

# ── 政府公开文件缓存不入库 ──
# 上海市教委《教学用书目录》原件。**公开文件也不转手** ——
# 入库的是从里面抽出来的结构化事实（data/shanghai-textbook-catalog.json）。
data/gov/

# ── 教材 PDF 缓存不入库 ──
# src/verify_order.py 从 TapXWorld/ChinaTextbook 下载的人教社教材 PDF，
# 只用来核对章节顺序。**每一页都印着「版权所有·未经许可不得采用任何方式
# 擅自复制或使用本产品任何部分·违者必究」**，而且体积不小（一上 48 MB）。
# 缓存进仓库等于再分发一次整本教材 —— 核对用途不需要承担这个。
# 需要时跑 `python3 src/verify_order.py --fetch` 重新拉。
data/pdf-cache/

# ── 从教材 PDF 渲染的页图（**已决定入库**，2026-10-27）──
# 渲染脚本：src/render_page_images.py
#   data/pages/<册次>/<页>.webp   1,128 页 / 82.1 MB
#   data/page-images-rjb.json/.js  索引
#
# ⚠️ 页图是**教材页面的复制**，每页都印着「版权所有…未经许可不得采用任何方式
# 擅自复制或使用本产品任何部分」。
# **沪教版那边走的是平台官方外链**（仓库里不存教材内容）；
# 人教版这边**本地 PDF 与平台副本页码对不上**（平台只有 2024 新版小学、
# 初中差印次），所以只能从本地 PDF 渲染 —— 渲染完就与我们的数据源**天然对齐**。
# 入库是用户 2026-10-27 的明确决定：**接受再分发，仓库 +82 MB**。
# 换成 JPEG 体积翻倍（WebP 1055px 宽 44 KB vs JPEG 91 KB），所以用 WebP。

# ── 讲解视频的中间产物 ──
# src/lesson_video/work/<id>/ 里是 TTS 音频（mp3）和每句一帧的截图（png）。
# **这些是可复现的中间产物**，不进仓库（一条视频几十 MB）。
# 进仓库的是：data/lesson-scripts/（手写的讲解稿）、data/lesson-drafts/（素材包）、
# video/（成片 mp4 + 封面帧 jpg）。
src/lesson_video/work/

# ── 盲测批次（派生产物）──
# src/make_batches.py 从 graph.json 切出来的模型输入片，760 KB。
# 切法随时会改，固化的是脚本不是片。要跑先 python3 src/make_batches.py
data/lmm-batches/

# ── 录制的中间产物 ──
viz/rec/

# ── 特意入库的（不要忽略）──
#   index.html            GitHub Pages 站点首页（与下面内容相同）
#   viz/知识图谱3D.html   成品页，1.9 MB 单文件
#   viz/录屏.mp4          6 秒演示
#   viz/知识图谱3D.png    截图
# 这几件是仓库的「门面」：clone 下来双击就能玩，不用先装 Python。
# 数据仍需 ./fetch.sh 拉取 —— 那是许可问题，不是可用性问题。

.DS_Store
__pycache__/
*.pyc
.venv/

# ── Milvus 数据库（派生产物）──
# data/milvus/kg_lite.db 是 milvus-lite 的库文件（二进制，几十 MB）。
# **不入库** —— 跑 python3 src/build_milvus.py 就能重建。
# ⚠️ 里面是**从教材里抽出来的段落**，不是教材原件 ——
#    但库文件会随数据版本不断变大，版本管理交给数据源那一层更合适。
data/milvus/*.db
data/milvus/*.db-*
data/milvus/*.lock
data/milvus/.kg_lite.db.lock

# ── 盲测模型产出（派生产物）──
# docs/lmm-protocol.md 里说的模型输出片。跑法见 src/make_batches.py
data/lmm-out/
node_modules
